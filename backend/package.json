{
  "name": "financy-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API GraphQL do Financy",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/infra/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@rocketseat/eslint-config": "3.0.12",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "9.39.5",
    "prisma": "7.10.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/fastify": "3.1.0",
    "@fastify/cors": "11.3.0",
    "@fastify/jwt": "10.2.2",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.3",
    "class-validator": "0.15.1",
    "fastify": "5.12.5",
    "graphql": "16.14.2",
    "graphql-scalars": "1.26.0",
    "reflect-metadata": "0.2.2",
    "type-graphql": "2.0.0-rc.3",
    "zod": "4.6.5"
  }
}
